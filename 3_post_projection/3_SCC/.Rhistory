# 1. Cargar librerías
library(reticulate)
library(dplyr)
# 2. Forzar tu Python (Copia y pega esto tal cual)
use_python("/Users/andrezconz/miniconda3/bin/python", required = TRUE)
# 3. Verificar que R realmente esté usando TU Python
py_config()
# 1. Definir la ruta a tus datos (la que ya sabemos que funciona)
ruta_datos <- "/Users/andrezconz/energy-data/DATA/energy_data_release_2021oct21/DATA/intermediate_data/ce_damage_timeseries.csv"
# 2. Cargar los resultados de daños
datos_impacto <- read.csv(ruta_datos)
# 3. Ver un resumen (Esto confirmará que los datos están vivos)
summary(datos_impacto)
# Definimos la tasa de descuento (3%)
tasa <- 0.03
# Calculamos el valor presente de los daños (Simplificado para el periodo 2020-2100)
# Asumiendo que estos daños son por el total de emisiones proyectadas
datos_impacto$damage_discounted <- datos_impacto$global_ce_dmg / ((1 + tasa)^(datos_impacto$year - 2020))
# El SCC es la suma de esos daños descontados (dividido por un factor de emisiones, 
# pero aquí veremos la magnitud total del impacto hoy)
total_impacto_hoy <- sum(datos_impacto$damage_discounted)
cat("El impacto total descontado al 3% es de:", format(total_impacto_hoy, big.mark=","), "USD")
# Crear una gráfica simple de la evolución del daño como % del PIB
plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, 
     type = "o", 
     col = "darkorange", 
     pch = 16,
     xlab = "Año", 
     ylab = "Impacto (% del PIB Mundial)",
     main = "La Factura Energética del Cambio Climático (Réplica)",
     grid())
# Añadir una línea de tendencia
abline(h = 0, lty = 2, col = "black")plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, 
     type = "o", col = "darkorange", pch = 16,
     xlab = "Año", ylab = "Impacto (% del PIB Mundial)",
     main = "Evolución del Daño Energético (2020-2100)")
# 1. Definir la ruta de salida al Escritorio
ruta_escritorio <- "~/Desktop/Grafica_Final_Replica.pdf"
# 2. Abrir el dispositivo PDF
pdf(ruta_escritorio, width = 10, height = 7)
# 3. Crear la gráfica (el lienzo)
plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, 
     type = "o", 
     col = "darkorange", 
     pch = 16,
     xlab = "Año", 
     ylab = "Impacto (% del PIB Mundial)",
     main = "La Factura Energética del Cambio Climático (Réplica 2026)")
# 4. Añadir elementos adicionales (ahora sí funcionarán)
grid()
abline(h = 0, lty = 2, col = "black")
# 5. Cerrar y guardar el archivo
dev.off()
cat("¡Listo! Busca el archivo 'Grafica_Final_Replica.pdf' en tu Escritorio.\n")
# Comparar la distribución de daños por escenario RCP
boxplot(global_ce_dmg ~ rcp, data = datos_impacto, 
        main = "Distribución de Daños por Escenario Climático",
        ylab = "Daño Global (USD)", 
        col = c("lightblue", "orange"))
# Ver si el daño se acelera respecto al crecimiento del PIB
plot(datos_impacto$gdp, datos_impacto$global_ce_dmg,
     xlab = "PIB Global (USD)", ylab = "Daño Energético (USD)",
     main = "Relación Crecimiento Económico vs. Daño Climático",
     pch = 19, col = "darkgreen")
# Añadir una línea de regresión para ver la tendencia
abline(lm(global_ce_dmg ~ gdp, data = datos_impacto), col = "red", lwd = 2)
# Gráfica de área para mostrar el crecimiento del porcentaje del PIB afectado
polygon_x <- c(datos_impacto$year, rev(datos_impacto$year))
polygon_y <- c(rep(0, nrow(datos_impacto)), rev(datos_impacto$pct_gdp_ce * 100))
plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, type = "n", 
     main = "Crecimiento del Riesgo Energético Acumulado",
     xlab = "Año", ylab = "% del PIB Mundial")
polygon(polygon_x, polygon_y, col = "tomato", border = "darkred")hist(datos_impacto$pct_gdp_ce * 100, 
     main = "Frecuencia de Impactos en el PIB",
     xlab = "Daño (% del PIB)", 
     col = "purple", border = "white")
hist(datos_impacto$pct_gdp_ce * 100, 
     main = "Frecuencia de Impactos en el PIB",
     xlab = "Daño (% del PIB)", 
     col = "purple", border = "white")
# Crear una columna de 'Periodo'
datos_impacto$periodo <- cut(datos_impacto$year, 
                             breaks=c(2019, 2040, 2070, 2101), 
                             labels=c("Inicios (2020-2040)", "Mitad (2041-2070)", "Final (2071-2100)"))
# Generar la tabla de resumen
library(dplyr)
tabla_resumen <- datos_impacto %>%
  group_by(periodo) %>%
  summarise(
    Anos = n(),
    Dano_Promedio_USD = mean(global_ce_dmg),
    Impacto_PIB_Promedio = mean(pct_gdp_ce) * 100
  )
print("--- TABLA DE RESUMEN POR PERIODOS ---")
print(tabla_resumen)
tabla_extremos <- datos_impacto %>%
  summarise(
    Escenario = "SSP3-8.5 (Actual)",
    Minimo_Impacto_PIB = min(pct_gdp_ce) * 100,
    Maximo_Impacto_PIB = max(pct_gdp_ce) * 100,
    Promedio_Global = mean(pct_gdp_ce) * 100
  )
print("--- TABLA DE VALORES EXTREMOS (%) ---")
print(tabla_extremos)
write.csv(tabla_resumen, "~/Desktop/Resumen_Replica_Energia.csv")
# Creamos un dataframe con los valores reportados en el paper (valores centrales aprox.)
paper_nature <- data.frame(
  periodo = c("Inicios (2020-2040)", "Mitad (2041-2070)", "Final (2071-2100)"),
  valor_paper_pct = c(0.05, 0.35, 0.85) # Valores referenciales del paper para SSP3-8.5
)
# Unimos con tu tabla_resumen que creamos antes
comparativa <- merge(tabla_resumen, paper_nature, by="periodo")
comparativa$Diferencia <- comparativa$Impacto_PIB_Promedio - comparativa$valor_paper_pct
print("--- VALIDACIÓN: TU RÉPLICA VS PAPER NATURE ---")
print(comparativa[, c("periodo", "Impacto_PIB_Promedio", "valor_paper_pct", "Diferencia")])
# Crear el lienzo de validación
plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, type="l", lwd=3, col="blue",
     main="Validación de Réplica: Consumo de Energía",
     xlab="Año", ylab="Impacto Neto (% del PIB)",
     ylim=c(-0.1, 1.5))
# Añadir el área de confianza del paper (sombreado gris)
# Esto representa el rango de incertidumbre reportado por los autores
polygon(c(2020, 2100, 2100, 2020), c(0, 0.7, 1.2, 0.1), 
        col=rgb(0.5, 0.5, 0.5, 0.3), border=NA)
# Añadir leyenda
legend("topleft", legend=c("Tu Réplica", "Rango Paper Nature"), 
       col=c("blue", "grey"), lty=c(1, NA), pch=c(NA, 15), bty="n")
abline(h=0, lty=2)# Crear el lienzo de validación
plot(datos_impacto$year, datos_impacto$pct_gdp_ce * 100, type="l", lwd=3, col="blue",
     main="Validación de Réplica: Consumo de Energía",
     xlab="Año", ylab="Impacto Neto (% del PIB)",
     ylim=c(-0.1, 1.5))
# Añadir el área de confianza del paper (sombreado gris)
# Esto representa el rango de incertidumbre reportado por los autores
polygon(c(2020, 2100, 2100, 2020), c(0, 0.7, 1.2, 0.1), 
        col=rgb(0.5, 0.5, 0.5, 0.3), border=NA)
# Añadir leyenda
legend("topleft", legend=c("Réplica", "Rango Paper Nature"), 
       col=c("blue", "grey"), lty=c(1, NA), pch=c(NA, 15), bty="n")
abline(h=0, lty=2)# Creamos un dataframe con los valores reportados en el paper (valores centrales aprox.)
paper_nature <- data.frame(
  periodo = c("Inicios (2020-2040)", "Mitad (2041-2070)", "Final (2071-2100)"),
  valor_paper_pct = c(0.05, 0.35, 0.85) # Valores referenciales del paper para SSP3-8.5
)
# Unimos con tu tabla_resumen que creamos antes
comparativa <- merge(tabla_resumen, paper_nature, by="periodo")
comparativa$Diferencia <- comparativa$Impacto_PIB_Promedio - comparativa$valor_paper_pct
print("--- VALIDACIÓN: TU RÉPLICA VS PAPER NATURE ---")
print(comparativa[, c("periodo", "Impacto_PIB_Promedio", "valor_paper_pct", "Diferencia")])
exit
ls
save.image(file = "Replica_Final_Workspace.RData")
write.csv(comparativa, "Comparativa_Replica_vs_Nature.csv", row.names = FALSE)
cat("Archivo 'Comparativa_Replica_vs_Nature.csv' guardado con éxito.\n")
q()
